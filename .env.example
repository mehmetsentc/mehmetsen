# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Configuration
NEXT_PUBLIC_APP_NAME=NaHaber
# Public site URL (HTTPS in production). Use canonical domain on Vercel:
# NEXT_PUBLIC_APP_URL=https://www.nahaber.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_X_URL=https://x.com/nahabercom
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/nahabercom
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/nahabercom
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@nahabercom

# Google Search Console — HTML tag verification (Search Console → Settings → Ownership verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# API Configuration (Phase 2)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags (Phase 2)
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Development
NODE_ENV=development

# Admin / CMS (server-only — never prefix with NEXT_PUBLIC_)
#
# Super admin email: grants full CMS API access via verifyCmsToken before Firestore role is set.
# After first login, call POST /api/admin/bootstrap to persist super_admin in Firestore.
SUPER_ADMIN_EMAIL=
#
# Bootstrap UIDs: one-time promotion for initial admin setup (server-only).
ADMIN_BOOTSTRAP_UIDS=
#
# Legacy (deprecated — use ADMIN_BOOTSTRAP_UIDS + Firestore role instead):
NEXT_PUBLIC_ADMIN_UIDS=
# admin write operations (categories, reports, user roles, etc.).
#
# Firebase Admin SDK (optional — enables /api/admin/bootstrap auto-promotion):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or discrete vars: FIREBASE_ADMIN_PROJECT_ID, FIREBASE_ADMIN_CLIENT_EMAIL,
# FIREBASE_ADMIN_PRIVATE_KEY

# AI Content Moderation (server-only, do NOT prefix with NEXT_PUBLIC_)
# When set, post/news text + images are checked with the OpenAI Moderation API
# (omni-moderation-latest). When unset, a deterministic TR/EN keyword heuristic
# is used as a fallback. Flagged content is held as `pending` for admin approval.
OPENAI_API_KEY=

# Policy for media that cannot be inspected without an AI vision/video provider
# (always applies to videos; applies to images when OPENAI_API_KEY is unset).
#   approve = let unverifiable media through so the app stays usable (DEFAULT)
#   review  = force any post with unverifiable media into pending/admin review
# TODO: real vision/video moderation requires a provider key; this is a stopgap.
MODERATE_MEDIA_DEFAULT=approve

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only — event sync writes to Firestore)
# ---------------------------------------------------------------------------
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Alternative: paste the full JSON as FIREBASE_SERVICE_ACCOUNT_JSON (single line).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# ---------------------------------------------------------------------------
# Events daily sync (server-only)
# ---------------------------------------------------------------------------
# Secret for cron / CLI: POST /api/events/sync with Authorization: Bearer <secret>
# Vercel cron uses CRON_SECRET automatically when set in the Vercel dashboard.
EVENTS_SYNC_SECRET=
CRON_SECRET=
# Remote app URL only — forces HTTP sync in scripts/sync-events.mjs (cron / production).
# Omit for local runs (direct Admin SDK). Localhost values are ignored unless you pass --http.
EVENTS_SYNC_APP_URL=

# ---------------------------------------------------------------------------
# Events providers — external Turkish ticket platforms (server-only)
# ---------------------------------------------------------------------------
# Providers are scraped daily by /api/events/sync (not on page load).
# /api/events/aggregate remains for manual/debug use. None of these may be
# prefixed with NEXT_PUBLIC_ (they must stay server-only).

# Biletix (Ticketmaster TR) — LIVE via its public Solr JSON endpoint.
#   BILETIX_DISABLED=true        # turn the adapter off
#   BILETIX_API_URL=...          # override the Solr select endpoint
#   BILETIX_IMAGE_BASE=...       # override the cover-image base URL (defaults to
#                                # www.biletix.com/static/.../eventimages/960x540;
#                                # images are served via /api/events/image)
BILETIX_DISABLED=
BILETIX_API_URL=
BILETIX_IMAGE_BASE=

# Bubilet — LIVE by scraping city pages + per-event schema.org JSON-LD.
#   BUBILET_DISABLED=true        # turn the adapter off
#   BUBILET_BASE_URL=...         # override host (default https://www.bubilet.com.tr)
#   BUBILET_MAX_EVENTS=24        # per-city detail-fetch cap
BUBILET_DISABLED=
BUBILET_BASE_URL=
BUBILET_MAX_EVENTS=

# Biletino — behind Cloudflare (HTTP 403 for plain requests), so OFF by default.
# Enable only if you have a reachable endpoint/proxy (no headless browser here).
#   BILETINO_ENABLED=true
#   BILETINO_BASE_URL=...        # a reachable Biletino/proxy base URL
BILETINO_ENABLED=
BILETINO_BASE_URL=

# Generic provider — front any JSON events API (in-house, or a Mobilet/Passo/
# Bugece partner API). Disabled until EVENTS_GENERIC_API_URL is set. Expected
# response: an array of events, or { events: [...] } / { data: [...] }.
EVENTS_GENERIC_API_URL=
EVENTS_GENERIC_API_KEY=
