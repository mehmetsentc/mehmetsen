# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Configuration
NEXT_PUBLIC_APP_NAME=NaHaber
# Public site URL (HTTPS in production). Use canonical domain on Vercel:
# NEXT_PUBLIC_APP_URL=https://www.nahaber.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_X_URL=https://x.com/nahabercom
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/nahabercom
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/nahabercom
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@nahabercom

# Google Search Console — HTML tag verification (Search Console → Settings → Ownership verification)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Yandex Webmaster — meta tag verification
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
# Bing Webmaster Tools — msvalidate.01 meta tag verification
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# IndexNow API key — must match public/{key}.txt on production host
INDEXNOW_KEY=nahaber2026index

# API Configuration (Phase 2)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Feature Flags (Phase 2)
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Development
NODE_ENV=development

# Admin / CMS (server-only — never prefix with NEXT_PUBLIC_)
#
# Super admin email: grants full CMS API access via verifyCmsToken before Firestore role is set.
# After first login, call POST /api/admin/bootstrap to persist super_admin in Firestore.
SUPER_ADMIN_EMAIL=
#
# Bootstrap UIDs: one-time promotion for initial admin setup (server-only).
ADMIN_BOOTSTRAP_UIDS=
#
# Legacy (deprecated — use ADMIN_BOOTSTRAP_UIDS + Firestore role instead):
NEXT_PUBLIC_ADMIN_UIDS=
# admin write operations (categories, reports, user roles, etc.).
#
# Firebase Admin SDK (optional — enables /api/admin/bootstrap auto-promotion):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or discrete vars: FIREBASE_ADMIN_PROJECT_ID, FIREBASE_ADMIN_CLIENT_EMAIL,
# FIREBASE_ADMIN_PRIVATE_KEY

# AI Content Moderation (server-only, do NOT prefix with NEXT_PUBLIC_)
# When set, post/news text + images are checked with the OpenAI Moderation API
# (omni-moderation-latest). When unset, a deterministic TR/EN keyword heuristic
# is used as a fallback. Flagged content is held as `pending` for admin approval.
OPENAI_API_KEY=

# Policy for media that cannot be inspected without an AI vision/video provider
# (always applies to videos; applies to images when OPENAI_API_KEY is unset).
#   approve = let unverifiable media through so the app stays usable (DEFAULT)
#   review  = force any post with unverifiable media into pending/admin review
# TODO: real vision/video moderation requires a provider key; this is a stopgap.
MODERATE_MEDIA_DEFAULT=approve

# ---------------------------------------------------------------------------
# Firebase Admin SDK (server-only — event sync writes to Firestore)
# ---------------------------------------------------------------------------
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Alternative: paste the full JSON as FIREBASE_SERVICE_ACCOUNT_JSON (single line).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or set GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccount.json

# ---------------------------------------------------------------------------
# Events daily sync (server-only)
# ---------------------------------------------------------------------------
# Secret for cron / CLI: POST /api/events/sync with Authorization: Bearer <secret>
# Vercel cron uses CRON_SECRET automatically when set in the Vercel dashboard.
EVENTS_SYNC_SECRET=
CRON_SECRET=
# Remote app URL only — forces HTTP sync in scripts/sync-events.mjs (cron / production).
# Omit for local runs (direct Admin SDK). Localhost values are ignored unless you pass --http.
EVENTS_SYNC_APP_URL=

# ---------------------------------------------------------------------------
# Events providers — external Turkish ticket platforms (server-only)
# ---------------------------------------------------------------------------
# Providers are scraped daily by /api/events/sync (not on page load).
# /api/events/aggregate remains for manual/debug use. None of these may be
# prefixed with NEXT_PUBLIC_ (they must stay server-only).

# Biletix (Ticketmaster TR) — LIVE via its public Solr JSON endpoint.
#   BILETIX_DISABLED=true        # turn the adapter off
#   BILETIX_API_URL=...          # override the Solr select endpoint
#   BILETIX_IMAGE_BASE=...       # override the cover-image base URL (defaults to
#                                # www.biletix.com/static/.../eventimages/960x540;
#                                # images are served via /api/events/image)
BILETIX_DISABLED=
BILETIX_API_URL=
BILETIX_IMAGE_BASE=

# Bubilet — LIVE by scraping city pages + per-event schema.org JSON-LD.
#   BUBILET_DISABLED=true        # turn the adapter off
#   BUBILET_BASE_URL=...         # override host (default https://www.bubilet.com.tr)
#   BUBILET_MAX_EVENTS=24        # per-city detail-fetch cap
BUBILET_DISABLED=
BUBILET_BASE_URL=
BUBILET_MAX_EVENTS=

# Biletino — behind Cloudflare (HTTP 403 for plain requests), so OFF by default.
# Enable only if you have a reachable endpoint/proxy (no headless browser here).
#   BILETINO_ENABLED=true
#   BILETINO_BASE_URL=...        # a reachable Biletino/proxy base URL
BILETINO_ENABLED=
BILETINO_BASE_URL=

# Generic provider — front any JSON events API (in-house, or a Mobilet/Passo/
# Bugece partner API). Disabled until EVENTS_GENERIC_API_URL is set. Expected
# response: an array of events, or { events: [...] } / { data: [...] }.
EVENTS_GENERIC_API_URL=
EVENTS_GENERIC_API_KEY=

# Paribu Cineverse — Çanakkale 17 Burda cinema showtimes (server-only scraper).
# Synced daily by /api/cron/paribu-canakkale (08:00 Europe/Istanbul).
# Manual: npm run sync-paribu-canakkale
# PARIBU_CINEVERSE_DISABLED=true
# PARIBU_CINEVERSE_DAYS_AHEAD=7
PARIBU_CINEVERSE_DISABLED=
PARIBU_CINEVERSE_DAYS_AHEAD=

# ---------------------------------------------------------------------------
# İŞKUR job listings (city /is-ilanlari) — Apify actor sevimliai/iskur-ilan-scraper-email
# ---------------------------------------------------------------------------
# Daily cron: GET /api/cron/iskur-jobs (09:00 Europe/Istanbul). Dataset items →
# Firestore `jobListings`. Email delivery is an actor requirement, not product UX.
#
# WARNING: Actor requires a real İŞKUR login (TC + şifre). Account ToS / compliance
# risk is on the operator. Never invent jobs; UI attributes “Kaynak: İŞKUR”.
# NEVER commit real credentials.
#
# Required:
APIFY_TOKEN=
ISKUR_TC_KIMLIK_NO=
ISKUR_SIFRE=
ISKUR_EMAIL_RECIPIENT=
ISKUR_EMAIL_SENDER=
ISKUR_EMAIL_PASSWORD=
#
# Optional SMTP / filters:
# ISKUR_SMTP_HOST=smtp.yandex.com
# ISKUR_SMTP_PORT=587
# ISKUR_EMAIL_SUBJECT_PREFIX=NaHaber İŞKUR
# ISKUR_ISYERI_TURU=ozel          # ozel | kamu
# ISKUR_ILAN_TARIHI=3             # 2=24h | 3=1 hafta | 4=15 gün
# ISKUR_ILAN_TURU=hepsi           # normal | iup | typ | hepsi
# ISKUR_SYNC_CITIES=canakkale     # comma-separated province slugs
#
# Actor `il` mapping examples (citySlug → uppercase Turkish name):
#   canakkale → ÇANAKKALE
#   istanbul  → İSTANBUL
#   izmir     → İZMİR
#   ankara    → ANKARA

# ---------------------------------------------------------------------------
# AI Newsroom — haber toplama, yeniden yazım, arama fallback (server-only)
# ---------------------------------------------------------------------------
# Zorunlu: toplu haber yeniden yazımı (4 aşamalı editör zinciri)
DEEPSEEK_API_KEY=
# DeepSeek V4 model (deepseek-chat 2026-07-24 emekli) — varsayılan deepseek-v4-flash
# Opsiyonel: DEEPSEEK_NEWS_MODEL=deepseek-v4-flash
#
# Phase 1 AI usage telemetry (observability only — haber üretimini değiştirmez)
# AI_USAGE_TELEMETRY_ENABLED=false  → Firestore usage yazmayı durdurur, AI çağrıları devam eder
# AI_USAGE_DEBUG=1                  → kısa [AI_USAGE] log (prompt yazılmaz)
# Tahmini maliyet — tanımlı değilse token kaydı çalışır, cost boş kalır. Rastgele fiyat yazmayın.
# DEEPSEEK_INPUT_COST_PER_1M=
# DEEPSEEK_OUTPUT_COST_PER_1M=
# DEEPSEEK_CACHE_HIT_COST_PER_1M=
# DEEPSEEK_CACHE_MISS_COST_PER_1M=
#
# Phase 2A — Groq classifier canary (default OFF). Missing GROQ_API_KEY never forces Groq.
# GROQ_API_KEY=
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_STRONG_MODEL=openai/gpt-oss-120b
# AI_GROQ_CLASSIFIERS_ENABLED=false
# AI_GROQ_PERCENT=0
# Soft dashboard warning only — never stops news generation:
# AI_DAILY_DEEPSEEK_TOKEN_WARNING=
#
# Phase 2B — multi-provider router (default OFF). Missing keys skip that provider.
# AI_MULTI_PROVIDER_ENABLED=false
# AI_MULTI_PROVIDER_PERCENT=0
# AI_MULTI_PROVIDER_CLASSIFICATION_ENABLED=true
# AI_MULTI_PROVIDER_EXTRACTION_ENABLED=false
# AI_MULTI_PROVIDER_SOCIAL_ENABLED=false
# AI_MULTI_PROVIDER_LONGFORM_ENABLED=false
# AI_STAGE1_CHEAP_PROVIDER_ENABLED=false
# AI_STAGE1_CHEAP_PROVIDER_PERCENT=0
# GEMINI_FAST_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_FAST_MODEL=
# Optional estimated cost (tokens still record if unset):
# GROQ_INPUT_COST_PER_1M=
# GROQ_OUTPUT_COST_PER_1M=
# GEMINI_INPUT_COST_PER_1M=
# GEMINI_OUTPUT_COST_PER_1M=
# OPENROUTER_INPUT_COST_PER_1M=
# OPENROUTER_OUTPUT_COST_PER_1M=
# Optional classification cache TTL ms (0/unset = off):
# AI_CLASSIFIER_CACHE_TTL_MS=
# Optional Stage3→classifier skip (default off):
# AI_SKIP_REDUNDANT_CLASSIFIER=false
#
# Phase 2C — observability + optional cost controls (absent = current limits; all default OFF)
# Do not enable in production until a dedicated canary:
# AI_STAGE1_SHADOW_ENABLED=false
# AI_STAGE1_SHADOW_PERCENT=0
# Phase 2F — Stage1 retry optimization canary (absent = current retry behavior):
# AI_STAGE1_RETRY_OPTIMIZATION_ENABLED=false
# AI_STAGE1_RETRY_OPTIMIZATION_PERCENT=0
# Phase 2L — Stage1 fail-fast after continuation/quality retry (absent = OFF):
# STAGE1_FAIL_FAST_ENABLED=false
# Phase 2D — Stage3 compact prompt canary (absent = control; do not enable in production until approved):
# AI_STAGE3_COMPACT_PROMPT_ENABLED=false
# AI_STAGE3_COMPACT_PROMPT_PERCENT=0
# Legacy alias (still requires PERCENT > 0 to select compact):
# AI_STAGE3_COMPACT_PROMPT=false
# AI_STAGE1_MAX_INPUT_CHARS=
# AI_STAGE1_MAX_OUTPUT_TOKENS=
# AI_STAGE3_MAX_INPUT_CHARS=
# AI_STAGE3_MAX_OUTPUT_TOKENS=
# AI_CHIEF_MAX_INPUT_CHARS=
# AI_CHIEF_MAX_OUTPUT_TOKENS=
#
# Canlı Google Search grounding + görsel analiz
GEMINI_API_KEY=
# Gemini kredi yokken CMS fallback kapalı. Kredi yükleyince: GEMINI_FALLBACK=true
# Opsiyonel: GEMINI_GROUNDING_MODEL=gemini-2.5-flash
# Opsiyonel: GEMINI_MODEL=gemini-2.5-flash
#
# Opsiyonel: Jina Reader — scraper bypass (ücretsiz tier var, key ile limit artar)
# https://jina.ai/reader
JINA_API_KEY=
#
# Opsiyonel: scraper başarısız olunca canlı arama fallback (birini yeter)
# Serper önerilir: https://serper.dev (~$1/1000 arama)
SERPER_API_KEY=
# Brave Search alternatif: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# City Network — PostgreSQL (Neon) + feature flags (server-only)
# ---------------------------------------------------------------------------
# Neon pooled connection string (used at runtime by Drizzle/Neon HTTP driver)
DATABASE_URL=
# Neon direct (unpooled) connection — used by drizzle-kit for migrations only
DATABASE_URL_UNPOOLED=
#
# Feature flags — ALL default OFF. No production behaviour changes until flipped.
#   CITY_NETWORK_ENABLED  — gate for any city-network / PG code paths
#   POSTGRES_READS_ENABLED — when true, read from Postgres instead of Firestore
CITY_NETWORK_ENABLED=false
POSTGRES_READS_ENABLED=false

# ---------------------------------------------------------------------------
# Cloudflare R2 — media storage (Phase 2+)
# ---------------------------------------------------------------------------
# R2 S3-compatible API credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name (default: nahaber-media)
R2_BUCKET_NAME=nahaber-media
# Public URL for serving media (custom domain or *.r2.dev)
R2_PUBLIC_URL=

# Facebook Page (Graph API — photo posts)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Global Meta App (fallback when site has no BYO app). Display Name in Meta Console → "Publisher"
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional public app id for OG meta
# NEXT_PUBLIC_FACEBOOK_APP_ID=

# Onyeditivi BYO Meta App (optional env fallback when Firestore config/socialFacebookApps empty)
# Page token MUST be issued by this App ID — otherwise attribution stays on global app.
# ONYEDITIVI_FB_APP_ID=
# ONYEDITIVI_FB_APP_SECRET=
# ONYEDITIVI_FB_APP_NAME=Onyeditivi Publisher
# ONYEDITIVI_FB_PAGE_ID=
# ONYEDITIVI_FB_PAGE_ACCESS_TOKEN=

# Encrypt BYO Facebook App secrets in Firestore (32-byte hex). Falls back to GMAIL_TOKEN_ENCRYPTION_KEY.
SECRET_ENCRYPTION_KEY=

# Meta Llama (Facebook caption rewrite) — never commit real key
LLAMA_API_KEY=
