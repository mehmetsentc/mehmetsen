{
  "id": "com.nahaber.app",
  "name": "NaHaber — Son Dakika Haberler",
  "short_name": "NaHaber",
  "description": "Türkiye'nin anlık haber platformu. Son dakika, spor, ekonomi, teknoloji, dünya ve yerel haberler.",
  "start_url": "/feed?utm_source=pwa&utm_medium=launch",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "background_color": "#0a0a0a",
  "theme_color": "#dc2626",
  "lang": "tr",
  "dir": "ltr",
  "orientation": "portrait",
  "categories": ["news", "magazines", "social"],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/brand/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
