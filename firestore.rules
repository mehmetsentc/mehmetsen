rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserDoc() ? userDoc().data.role : '';
    }

    function isCmsPublisher() {
      return isSignedIn()
        && userRole() in ['admin', 'super_admin', 'managing_editor', 'editor'];
    }

    function isCmsStaff() {
      return isSignedIn()
        && userRole() in ['admin', 'super_admin', 'managing_editor', 'editor', 'author', 'video_editor'];
    }

    function isAdmin() {
      return isCmsPublisher();
    }

    // likeService / saveService / commentService / postService increment these on `news`.
    function newsEngagementCounterFields() {
      return ['likesCount', 'savesCount', 'commentCount', 'commentsCount', 'viewsCount', 'sharesCount'];
    }

    function isNewsEngagementCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(newsEngagementCounterFields());
    }

    // View counts are bumped for guests (NewsArticleClient, VideoFeedItem).
    function isNewsViewCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']);
    }

    function isAuthorDraftNewsCreate() {
      return isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ['pending', 'draft'];
    }

    function isAuthorDraftNewsUpdate() {
      return isSignedIn()
        && resource.data.get('authorId', '') == request.auth.uid
        && resource.data.get('status', '') in ['pending', 'draft']
        && request.resource.data.get('status', '') in ['pending', 'draft'];
    }

    // eventService.recalculateEventRatings after eventReviews create/update.
    function isEventRatingAggregateUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['averageRating', 'ratingCount', 'reviewCount']);
    }

    // Public profiles: anyone can `get` a single doc or `list`/query the
    // collection (followService batches `documentId() in [...]`, search runs
    // username range/limit queries). `read` covers both `get` and `list`.
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isEventRatingAggregateUpdate();
    }

    match /eventReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Daily sync stats — admin dashboard only (written by Admin SDK cron).
    match /meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /news/{docId} {
      allow read: if true;
      allow create: if isCmsPublisher() || isAuthorDraftNewsCreate();
      allow update: if isAdmin()
        || isAuthorDraftNewsUpdate()
        || isNewsViewCounterUpdate()
        || (isSignedIn() && isNewsEngagementCounterUpdate());
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.get('authorId', '') == request.auth.uid);
    }

    // AI-ingested drafts: CMS staff read; publishers write
    match /newsDrafts/{draftId} {
      allow read: if isCmsStaff();
      allow create, update, delete: if isCmsPublisher();
    }

    // Historical RSS archive — public read for search; NOT the live product path
    match /newsArchive/{archiveId} {
      allow read: if true;
      allow write: if false;
    }

    // Autonomous newsroom — Admin SDK only (workers, queue, fingerprints)
    match /sourceFingerprints/{sourceId}/articles/{hash} {
      allow read, write: if false;
    }

    match /newsQueue/{queueId} {
      allow read, write: if false;
    }

    match /news/{docId}/editHistory/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // AI TTS reels + generated video metadata (public feed reads)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /saved/{saveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /notifications/{docId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.isDeleted == false;
        allow update: if isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
