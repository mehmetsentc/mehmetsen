rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return hasUserDoc() ? userDoc().data.role : '';
    }

    // Phase 1 (Çanakkale pilot): staff carrying `cmsScope` (city / category managers)
    // never get direct client-SDK CMS privileges. They act only through server API
    // routes that enforce province AND category scope (src/lib/cms/staffScopeHttp.ts).
    // super_admin is never scoped. Missing `cmsScope` = unchanged legacy behavior.
    function isScopedStaff() {
      return hasUserDoc()
        && userRole() != 'super_admin'
        && userDoc().data.get('cmsScope', null) != null;
    }

    function isCmsPublisher() {
      return isSignedIn()
        && userRole() in ['admin', 'super_admin', 'managing_editor', 'editor']
        && !isScopedStaff();
    }

    function isCmsStaff() {
      return isSignedIn()
        && userRole() in ['admin', 'super_admin', 'managing_editor', 'editor', 'author', 'video_editor']
        && !isScopedStaff();
    }

    function isAdmin() {
      return isCmsPublisher();
    }

    // SEC-CMS-ROLE-ESCALATION-1 — users/{uid} fields that grant or limit server-side
    // authority. Single list, mirrored by AUTHORIZATION_SENSITIVE_USER_FIELDS in
    // src/lib/cms/authorizationSensitiveUserFields.ts:
    //   role        → resolveCmsRoleFromFirestore (verifyCmsToken, cms-sync, newsroomAuth,
    //                 events/sync, iskur-jobs) and every role check in these rules
    //   permissions → /api/admin/gmail/callback (`permissions.includes('system:settings')`)
    //   cmsScope    → Phase 1 staff scope (verifyCmsToken / rbacScope, isScopedStaff above)
    //   isAdmin, admin → legacy privileged keys (no current reader; kept closed)
    function authorizationSensitiveUserFields() {
      return ['role', 'permissions', 'cmsScope', 'isAdmin', 'admin'];
    }

    // Covers add, change AND removal of a key (diff().affectedKeys()), so update(),
    // set() overwrite and set(merge) cannot delete `role` / `cmsScope` either.
    function touchesAuthorizationSensitiveUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(authorizationSensitiveUserFields());
    }

    // Only a super_admin (Firestore role, set by /api/auth/cms-sync from
    // SUPER_ADMIN_EMAIL) may change another account's authority from a client.
    // Matches the server matrix: `users:assign_role` belongs to super_admin only.
    // super_admin is never scoped (isScopedStaff excludes it).
    function isUserAuthorityAdministrator() {
      return isSignedIn() && userRole() == 'super_admin';
    }

    // likeService / saveService / commentService / postService increment these on `news`.
    function newsEngagementCounterFields() {
      return ['likesCount', 'savesCount', 'commentCount', 'commentsCount', 'viewsCount', 'sharesCount'];
    }

    function isNewsEngagementCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(newsEngagementCounterFields());
    }

    // View counts are bumped for guests (NewsArticleClient, VideoFeedItem).
    function isNewsViewCounterUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']);
    }

    function isAuthorDraftNewsCreate() {
      return isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status in ['pending', 'draft'];
    }

    function isAuthorDraftNewsUpdate() {
      return isSignedIn()
        && resource.data.get('authorId', '') == request.auth.uid
        && resource.data.get('status', '') in ['pending', 'draft']
        && request.resource.data.get('status', '') in ['pending', 'draft'];
    }

    // eventService.recalculateEventRatings after eventReviews create/update.
    function isEventRatingAggregateUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['averageRating', 'ratingCount', 'reviewCount']);
    }

    // Public profiles: anyone can `get` a single doc or `list`/query the
    // collection (followService batches `documentId() in [...]`, search runs
    // username range/limit queries). `read` covers both `get` and `list`.
    match /users/{userId} {
      allow read: if true;
      // Self-signup creates a plain user doc. No authority field may be supplied
      // except role absent / 'user' / null (permissions, cmsScope, isAdmin, admin: never).
      allow create: if isOwner(userId)
        && (!('role' in request.resource.data)
            || request.resource.data.role == 'user'
            || request.resource.data.role == null)
        && !request.resource.data.keys()
            .hasAny(['permissions', 'cmsScope', 'isAdmin', 'admin']);
      // Profile / moderation fields: CMS publishers (any user) and owners (self).
      // Authority fields: super_admin only. Editors and managing editors can no longer
      // change roles, scopes or permissions — their own or anyone else's.
      allow update: if (isAdmin() || isOwner(userId))
        && (!touchesAuthorizationSensitiveUserFields() || isUserAuthorityAdministrator());
      // No client delete → no delete / recreate path around field rules.
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isEventRatingAggregateUpdate();
    }

    // City job board — public read; writes only via Admin SDK cron/sync.
    match /jobListings/{listingId} {
      allow read: if true;
      allow write: if false;
    }

    // On-duty pharmacies — public read; writes only via Admin SDK cron/sync.
    match /dutyPharmacies/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /eventReviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Daily sync stats — admin dashboard only (written by Admin SDK cron).
    match /meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Custom pageview analytics — written by /api/analytics/track (Admin SDK).
    match /analyticsDaily/{dateId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Core Web Vitals — written by /api/analytics/vitals (Admin SDK).
    match /analyticsVitals/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /news/{docId} {
      allow read: if true;
      allow create: if isCmsPublisher() || isAuthorDraftNewsCreate();
      allow update: if isAdmin()
        || isAuthorDraftNewsUpdate()
        || isNewsViewCounterUpdate()
        || (isSignedIn() && isNewsEngagementCounterUpdate());
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.get('authorId', '') == request.auth.uid);
    }

    // Drafts: CMS staff read; CMS publishers write. No direct-browser UGC path —
    // reader submissions go through /api/ugc/submit (Admin SDK, server-built fields).
    // Scoped staff stay excluded via isCmsStaff()/isCmsPublisher() (SEC-UGC-INTEGRITY-REPAIR-1).
    match /newsDrafts/{draftId} {
      allow read: if isCmsStaff();
      allow create, update, delete: if isCmsPublisher();
    }

    // Historical RSS archive — public read for search; NOT the live product path
    match /newsArchive/{archiveId} {
      allow read: if true;
      allow write: if false;
    }

    // Autonomous newsroom — Admin SDK only (workers, queue, fingerprints)
    match /sourceFingerprints/{sourceId}/articles/{hash} {
      allow read, write: if false;
    }

    match /newsQueue/{queueId} {
      allow read: if isCmsStaff();
      allow write: if false;
    }

    match /newsroomStoryLibrary/{entryId} {
      allow read, write: if false;
    }

    // Cron monitor — CMS staff okur; yazma yalnız Admin SDK
    match /cronRuns/{runId} {
      allow read: if isCmsStaff();
      allow write: if false;
    }

    // AI Editorial Newsroom V2 — Admin SDK only (no client writes)
    match /aiEditors/{editorId} {
      allow read, write: if false;
    }
    match /aiEditorPrompts/{promptId} {
      allow read, write: if false;
    }
    match /aiModelRegistry/{modelId} {
      allow read, write: if false;
    }
    match /aiUsageEvents/{eventId} {
      allow read, write: if false;
    }

    match /news/{docId}/editHistory/{entryId} {
      allow read: if true;
      allow write: if false;
    }

    // AI TTS reels + generated video metadata (public feed reads)
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.authorId == request.auth.uid;
    }

    match /likes/{likeId} {
      // Owner-only reads — prevent enumerating other users' likes.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /saved/{saveId} {
      // Owner-only reads — prevent enumerating other users' bookmarks.
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    match /newsletterSubscribers/{emailId} {
      allow read, write: if false; // server Admin SDK only
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.followerId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Notifications model:
    //   userId = recipient (the person who will SEE the notification)
    //   actorId = who triggered it (e.g. comment author, follower)
    // The recipient owns the doc (read/update/delete), but creates have to
    // be allowed from the *actor's* session — otherwise a like/comment/follow
    // could never create a notification for someone else. We constrain those
    // cross-user creates so the caller must be the actor and the payload
    // must look like a notification rather than a privileged write.
    function isOwnNotificationCreate() {
      return request.resource.data.userId == request.auth.uid;
    }
    function isCrossUserNotificationCreate() {
      return request.resource.data.actorId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.read == false;
    }
    match /notifications/{docId} {
      allow read, update: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && (isOwnNotificationCreate() || isCrossUserNotificationCreate());
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /posts/{docId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantIds.size() == 2;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isConversationParticipant(conversationId);
        allow create: if isConversationParticipant(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.isDeleted == false;
        allow update: if isConversationParticipant(conversationId)
          && resource.data.senderId == request.auth.uid;
      }
    }
    match /gameScores/{scoreId} {
      allow read: if true;
      // Yazma yalnızca Admin SDK (API /api/games/scores)
      allow write: if false;
    }
  }
}
