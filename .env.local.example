# ================================================
# NaHaber — Environment Variables
# Bu dosyayı kopyalayıp .env.local olarak kaydet
# Firebase Console > Project Settings'ten al
# ================================================
#
# ── Vercel Pro (Dashboard → Project Settings) ──
# Aşağıdakiler repoda vercel.json ile ayarlanır; Dashboard'da da kontrol edin:
#   • Functions → Fluid Compute: ON (daha hızlı cold start, daha az maliyet)
#   • Functions → Region: fra1 (Frankfurt — Türkiye + Firebase EU için en yakın)
#   • Deployment Protection → Skew Protection: ON (deploy sırasında eski sürüm tutarlılığı)
#   • Speed Insights + Web Analytics: ON (layout.tsx'te zaten entegre)
#   • Cron Jobs: vercel.json deploy sonrası otomatik görünür (26 job)
# Vercel env (Production):
#   CRON_SECRET=<güçlü-random>  — cron auth (Vercel otomatik Bearer enjekte eder)
#   NEXT_PUBLIC_APP_URL=https://www.nahaber.com  — canonical domain (sitemap, OG, paylaşım)
#   FIREBASE_ADMIN_* veya FIREBASE_SERVICE_ACCOUNT_JSON — serverless fonksiyonlar için
#

# Firebase Client Config (tarayıcıya açık)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Uygulama
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NaHaber

# Admin paneli (/admin) — yerel geliştirme için Firebase Auth UID'nizi ekleyin
# Firebase Console → Authentication → Users → UID sütunu
# Birden fazla admin: virgülle ayırın. Değişiklikten sonra `npm run dev` yeniden başlatın.
NEXT_PUBLIC_ADMIN_UIDS=

# Firebase Admin SDK (sadece server-side, NEXT_PUBLIC_ olmaz)
# Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Alternatif: tüm JSON'u tek satır olarak
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Etkinlik günlük senkronizasyonu (cron / CLI)
EVENTS_SYNC_SECRET=your-random-sync-secret
# Vercel cron otomatik CRON_SECRET kullanır
CRON_SECRET=your-random-sync-secret
# Uzak sunucu URL (örn. https://nahaber.vercel.app) — HTTP sync zorlar. Yerelde boş bırakın (doğrudan Admin SDK).
# EVENTS_SYNC_APP_URL=https://nahaber.vercel.app

# AI haber ingestion (RSS → OpenAI → pending queue)
OPENAI_API_KEY=sk-your-openai-api-key
# Opsiyonel: varsayılan gpt-4o-mini
OPENAI_NEWS_MODEL=gpt-4o-mini
# Opsiyonel: cron başına max AI çağrısı (varsayılan 12)
NEWS_INGEST_MAX_AI_CALLS=12
# Opsiyonel: ingest için ayrı secret (yoksa CRON_SECRET kullanılır)
# NEWS_INGEST_SECRET=your-random-ingest-secret
# Opsiyonel: tek kaynak feed URL override — RSS_FEED_AA=https://...
# RSS_DISABLED_SOURCES=reuters,cnn

# Yerel ingest script hedefi (varsayılan http://localhost:3000)
# NEWS_INGEST_APP_URL=http://localhost:3000

# ================================================
# AI Newsroom — çoklu editör otonom haber odası
# ================================================

# confidenceScore >= bu eşik → otomatik yayın (admin onayı atlanır)
NEWSROOM_AUTO_PUBLISH_THRESHOLD=70

# Kalıcı olarak bozuk RSS kaynaklarını devre dışı bırak (virgülle)
# RSS_DISABLED_SOURCES=iha,dha,t24,gazeteduvar

# Cron auth — Vercel CRON_SECRET ile aynı olabilir
# NEWSROOM_CRON_SECRET=your-random-newsroom-secret

# Trend editörü — Google Trends RSS override
# NEWSROOM_TRENDS_RSS_URL=https://trends.google.com/trending/rss?geo=TR
# Fallback konular (virgülle): Google Trends erişilemezse
# NEWSROOM_TREND_TOPICS=Türkiye,İstanbul,ekonomi

# Influencer editörü — takip listesi (virgülle)
# NEWSROOM_INFLUENCERS=Cem Yılmaz,Hadise,Şeyma Subaşı

# CLI script hedefi (varsayılan http://localhost:3000)
# NEWSROOM_APP_URL=http://localhost:3000
