#!/usr/bin/env bash
# Optional local gate: blocks pushing commits whose messages contain [deploy]
# when today's Istanbul deploy quota is already full.
# Install: git config core.hooksPath scripts/git-hooks
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

remote_name="${1:-}"
remote_url="${2:-}"

# Read stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_sha:-}" || "$local_sha" =~ ^0+$ ]] && continue

  range=
  if [[ -n "${remote_sha:-}" && ! "$remote_sha" =~ ^0+$ ]]; then
    range="${remote_sha}..${local_sha}"
  else
    range="$local_sha"
  fi

  msgs="$(git log --format=%s "$range" 2>/dev/null || true)"
  if ! echo "$msgs" | grep -Eqi '\[deploy\]|\[force-deploy\]'; then
    continue
  fi

  if echo "$msgs" | grep -Eqi '\[force-deploy\]'; then
    echo "[pre-push] [force-deploy] present — allowing push"
    continue
  fi

  if ! node scripts/allow-deploy.mjs; then
    echo "[pre-push] Blocked [deploy] push (quota). Use [force-deploy] or wait."
    exit 1
  fi
done

exit 0
