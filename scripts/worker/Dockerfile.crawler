# FinOps (15 Nov 2026): standalone crawler tick worker for Railway (cron service).
# Runs scripts/worker/crawler-tick.ts with the same code as /api/cron/crawler/tick.
# Install scripts are skipped: the crawler path has no native modules (no sharp/canvas/ffmpeg).
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --include=dev --ignore-scripts --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
COPY scripts/worker ./scripts/worker
CMD ["npx", "--no-install", "tsx", "--tsconfig", "scripts/worker/tsconfig.json", "scripts/worker/crawler-tick.ts"]
